# Dispatcher WebSocket worker layered on the validated SCAIL-2 runtime image.
# This image deliberately runs the renamed source package cloned from Git rather
# than the scail2_inference distribution installed in the base image.
ARG BASE_IMAGE=localhost/scail2-inference:0.1.3
FROM ${BASE_IMAGE}

ARG SCAIL2_GIT_REPO=https://github.com/minghaop/scail2_exp.git
ARG SCAIL2_GIT_BRANCH=main

RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        iproute2 \
        libgl1 \
        libglib2.0-0 \
        lsof \
        nano \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN git clone \
        --depth 1 \
        --branch "${SCAIL2_GIT_BRANCH}" \
        --single-branch \
        "${SCAIL2_GIT_REPO}" \
        /opt/scail2-src

RUN python3.10 -m pip install --no-cache-dir \
        "fastapi==0.139.0" \
        "uvicorn[standard]==0.51.0"

WORKDIR /opt/scail2-src

EXPOSE 3000

ENTRYPOINT ["python3.10", "-u", "-m", "scail2_worker_service"]
CMD ["--port", "3000"]
